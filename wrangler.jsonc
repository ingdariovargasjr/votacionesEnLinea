{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "votaciones-api-testing",
  "main": "apps/api/src/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_WEB_URL": "https://votaciones-en-linea-testing.web.app",
    "CORS_ORIGINS": "https://votaciones-en-linea-testing.web.app"
  }
}
